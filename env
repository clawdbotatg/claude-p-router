#!/usr/bin/env python3
"""env hook — route this turn to the Claude subscription with most headroom.

If this box holds multiple Claude subscription logins — one config dir per
plan under ~/.clawd-accounts/<name>, each signed in ONCE via
    CLAUDE_CONFIG_DIR=~/.clawd-accounts/<name> claude /login
— every turn runs on the plan with the MOST HEADROOM right now. Usage comes
from Claude's OAuth usage endpoint (undocumented: every failure degrades to
"don't route"). The ORG is the usage pool: two config dirs logged into the
same org share one set of limits, so dirs are grouped by organizationUuid
(from each dir's .claude.json) and only one live login per pool is polled —
siblings are fallbacks when that login's creds have gone stale. The plain
~/.claude login participates as `default`. An
operator-set CLAUDE_CONFIG_DIR always wins (the engine passes the child env
through; if the pin is present we print nothing). Boxes with no account dirs
behave exactly as if this module were absent. Disable with CLAUDE_P_ROUTER=0.

Engine contract (see agent.py "modules"): stdout "KEY=VAL" merges into the
child env, "KEY=" removes the key; stderr passes through; non-zero exit or
timeout = ignored. Usage is TTL-cached in .cache.json next to this script
(a fresh process runs each turn, so the cache lives on disk).
"""
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
CACHE = os.path.join(HERE, ".cache.json")

ROUTER_ON = os.environ.get("CLAUDE_P_ROUTER", "1") != "0"
ROUTER_TTL = float(os.environ.get("CLAUDE_P_ROUTER_TTL", "600"))
ROUTER_STALE = float(os.environ.get("CLAUDE_P_ROUTER_STALE", "3600"))
ACCOUNTS_DIR = os.path.expanduser(
    os.environ.get("CLAWD_ACCOUNTS_DIR", "~/.clawd-accounts"))
OAUTH_CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"  # Claude Code's PUBLIC client id (non-secret) — gitleaks:allow
OAUTH_TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
OAUTH_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
OAUTH_PROFILE_URL = "https://api.anthropic.com/api/oauth/profile"
OAUTH_BETA = "oauth-2025-04-20"


def _keychain_service(config_dir):
    """Claude Code's own Keychain item derivation (macOS)."""
    if not config_dir:
        return "Claude Code-credentials"
    import hashlib
    import unicodedata
    nfc = unicodedata.normalize("NFC", config_dir)
    return "Claude Code-credentials-" + hashlib.sha256(nfc.encode()).hexdigest()[:8]


def _read_creds(config_dir):
    try:
        r = subprocess.run(["security", "find-generic-password",
                            "-s", _keychain_service(config_dir),
                            "-a", os.environ.get("USER", ""), "-w"],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return json.loads(r.stdout.strip())
    except Exception:
        pass
    path = os.path.join(config_dir or os.path.expanduser("~/.claude"),
                        ".credentials.json")
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def _usage_pct(config_dir):
    """% used of the most-constrained window for one login, or None."""
    import urllib.error
    import urllib.request
    oauth = (_read_creds(config_dir) or {}).get("claudeAiOauth") or {}
    access, refresh = oauth.get("accessToken"), oauth.get("refreshToken")
    if not access:
        return None

    def call(tok):
        req = urllib.request.Request(OAUTH_USAGE_URL, headers={
            "Authorization": f"Bearer {tok}", "anthropic-beta": OAUTH_BETA})
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                return r.status, json.loads(r.read().decode())
        except urllib.error.HTTPError as e:
            return e.code, None
        except Exception:
            return None, None

    code, usage = call(access)
    if code == 401 and refresh:
        req = urllib.request.Request(
            OAUTH_TOKEN_URL, method="POST",
            headers={"Content-Type": "application/json"},
            data=json.dumps({"grant_type": "refresh_token",
                             "refresh_token": refresh,
                             "client_id": OAUTH_CLIENT_ID}).encode())
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                fresh = json.loads(r.read().decode()).get("access_token")
        except Exception:
            fresh = None
        if fresh:
            code, usage = call(fresh)
    if code != 200 or not isinstance(usage, dict):
        return None
    worst = None
    for key in ("five_hour", "seven_day", "seven_day_opus", "seven_day_sonnet"):
        w = usage.get(key)
        u = w.get("utilization") if isinstance(w, dict) else w
        if isinstance(u, (int, float)):
            worst = u if worst is None else max(worst, u)
    return worst


def _org_uuid(config_dir):
    """The org this login belongs to — two logins to one org share limits."""
    path = os.path.join(config_dir or os.path.expanduser("~/.claude"),
                        ".claude.json")
    try:
        with open(path, encoding="utf-8") as f:
            acct = json.load(f).get("oauthAccount") or {}
        return acct.get("organizationUuid") or None
    except (OSError, ValueError):
        return None


def _org_from_profile(config_dir):
    """Org discovery fallback when .claude.json doesn't say (e.g. the plain
    ~/.claude login) — asks the OAuth profile endpoint (undocumented, same
    degrade-on-failure rules as usage). Result is cached on disk forever;
    an org only changes on re-login, and deleting .cache.json resets it."""
    import urllib.request
    oauth = (_read_creds(config_dir) or {}).get("claudeAiOauth") or {}
    tok = oauth.get("accessToken")
    if not tok:
        return None
    req = urllib.request.Request(OAUTH_PROFILE_URL, headers={
        "Authorization": f"Bearer {tok}", "anthropic-beta": OAUTH_BETA})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            org = json.loads(r.read().decode()).get("organization") or {}
        return org.get("uuid") or None
    except Exception:
        return None


def _load_cache():
    try:
        with open(CACHE, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _save_cache(cache):
    try:
        with open(CACHE, "w", encoding="utf-8") as f:
            json.dump(cache, f)
    except OSError:
        pass


def main():
    if not ROUTER_ON or os.environ.get("CLAUDE_CONFIG_DIR"):
        return                                   # off, or operator pinned a dir
    candidates = [("default", "")]
    try:
        candidates += sorted(
            (d.name, os.path.join(ACCOUNTS_DIR, d.name))
            for d in os.scandir(ACCOUNTS_DIR) if d.is_dir())
    except OSError:
        pass
    if len(candidates) < 2:
        return                                   # nothing to route between
    cache = _load_cache()
    # Group logins by org — the org is the pool (dirs sharing an org share
    # limits). Unknown org keeps its own key so it still participates alone.
    orgs = cache.get("_orgs") if isinstance(cache.get("_orgs"), dict) else {}
    pools = {}
    for name, cfg in candidates:
        key = _org_uuid(cfg) or orgs.get(name)
        if not key:
            key = _org_from_profile(cfg)
            if key:
                orgs[name] = key
        pools.setdefault(key or f"dir:{name}", []).append((name, cfg))
    cache["_orgs"] = orgs
    if len(pools) < 2:
        _save_cache(cache)
        return                                   # many dirs, one actual plan
    now = time.time()
    best_name, best_cfg, best_pct = None, None, None
    for _key, members in sorted(pools.items()):
        for name, cfg in members:                # first live login wins the pool
            c = cache.get(name)
            if not isinstance(c, dict) or now - c.get("ts", 0) > ROUTER_TTL:
                pct = _usage_pct(cfg)
                if pct is not None:
                    c = {"pct": pct, "ts": now}
                    cache[name] = c
                elif isinstance(c, dict) and now - c.get("ts", 0) < ROUTER_STALE:
                    pass    # endpoint flaked (429/blip) — stale reading beats
                            # dropping the whole pool; retried on every run
                else:
                    cache.pop(name, None)
                    continue                     # dead creds — try a sibling
            if best_pct is None or c["pct"] < best_pct:
                best_name, best_cfg, best_pct = name, cfg, c["pct"]
            break
    if best_name is None:
        _save_cache(cache)
        return
    if best_cfg:
        # share the transcript store so sessions resume under any plan
        src = os.path.expanduser("~/.claude/projects")
        dst = os.path.join(best_cfg, "projects")
        try:
            os.makedirs(src, exist_ok=True)
            if not os.path.lexists(dst):
                os.symlink(src, dst)
        except OSError:
            pass
        print(f"CLAUDE_CONFIG_DIR={best_cfg}")
    else:
        print("CLAUDE_CONFIG_DIR=")              # empty value = remove the key
    # self-awareness breadcrumb: lets tools/vitals distinguish "the router
    # chose this plan" from "an operator pin / inherited env" (pinned turns
    # never reach here, so the var's absence means we didn't route)
    print(f"CLAUDE_P_ROUTER_PLAN={best_name}")
    if cache.get("_last") != best_name:
        cache["_last"] = best_name
        print(f"[router] turns run on plan {best_name!r} ({best_pct:.0f}% used)"
              f" — {len(pools)} pool(s) across {len(candidates)} login(s)",
              file=sys.stderr)
    _save_cache(cache)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:                       # any surprise = don't route
        print(f"[router] degraded (no routing): {e}", file=sys.stderr)
        sys.exit(0)
